{
  "name": "flyrank-capstone-widget-platform",
  "version": "0.1.0",
  "private": false,
  "description": "Embeddable widget and resilient lead-capture capstone",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
