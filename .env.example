# Local development — copy to .env. Do not commit .env or real credentials.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DEMO_PORT=5500
# Optional comma-separated extra exact origins for the seeded demo widget.
DEMO_ALLOWED_ORIGINS=
POSTGRES_PORT=5432
DATABASE_URL=postgres://widget:widget@localhost:5432/widget_platform
TEST_DATABASE_URL=postgres://widget:widget@localhost:5432/widget_platform_test
JWT_SECRET=local-dev-only-change-me-to-a-long-random-secret
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
RATE_LIMIT_PER_WIDGET_MAX=100
BODY_LIMIT=10kb
GEO_TIMEOUT_MS=2500
NOTIFICATION_POLL_MS=1000
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_BASE_DELAY_MS=1000
# Optional failure alert; console-only when blank.
ALERT_WEBHOOK_URL=
# Confirmation side effect: "console" (default) or "smtp" to deliver into Mailpit.
NOTIFICATION_TRANSPORT=console
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=widgets@localhost
SMTP_TO=owner@example.test
# Mailpit host ports (docker compose up -d mailpit; UI at http://localhost:8025)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Used by npm run geo:check (any public IP works, e.g. 8.8.8.8).
GEO_CHECK_IP=8.8.8.8
